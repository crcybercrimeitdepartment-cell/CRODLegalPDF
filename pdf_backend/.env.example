APP_NAME=PDF Backend API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8000
STORAGE_DIR=app/storage
UPLOAD_DIR=app/storage/uploads
OUTPUT_DIR=app/storage/outputs
TEMP_DIR=app/temp
MAX_UPLOAD_SIZE_MB=100
MAX_UPLOAD_FILES=20
FILE_EXPIRY_MINUTES=30
CLEANUP_INTERVAL_SECONDS=300
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
API_PREFIX=/api
