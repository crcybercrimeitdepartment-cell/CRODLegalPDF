@router.post("/convert-to-pdf/mobi-to-pdf/process")
async def mobi_to_pdf_process(request_id: str = Form(...), filename: str = Form(...)):
    try:
        result = await mobi_to_pdf_service.process(request_id=request_id, filenames=[filename], config={})
        if "pdf_filename" in result:
            pdf_filename = result["pdf_filename"]
        elif "results" in result and isinstance(result["results"], list) and len(result["results"]) > 0 and "pdf_filename" in result["results"][0]:
            pdf_filename = result["results"][0]["pdf_filename"]
